# Production environment template. Copy to .env on the production host and fill
# in the real secrets. Never commit real values.
NODE_ENV=production

# Database Configuration
DATABASE_URL=
DIRECT_URL=

# NextAuth Configuration
NEXTAUTH_URL=https://jkishema.com
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true

APP_ENV=production

# WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_NAME=jkishema_registration_qr_3
WHATSAPP_TEMPLATE_LANG=id
WHATSAPP_MOCK_MODE=false
WHATSAPP_SENDING_ENABLED=false
WHATSAPP_DAILY_SEND_CAP=249
WHATSAPP_TIMEOUT_MS=15000

# WhatsApp Webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Internal worker endpoint auth.
CRON_SECRET=

# Master admin seed. Do not store these here; pass them inline for the first seed only:
#   MASTER_ADMIN_USERNAME=... MASTER_ADMIN_PASSWORD=... npx prisma db seed
