# ==============================================================================
# JKI Shema Christmas Concert - E2E Testing Runtime Configuration (Safe Example)
# ==============================================================================
# Copy this file to .env.e2e.local when running local E2E tests.
# NEVER put real Meta tokens or production credentials into this file.
# Local .env.e2e.local files are strictly excluded by .gitignore.

# 1. Application Runtime Environment
# Note: Next.js dev server (npm run dev:e2e) requires NODE_ENV=development.
# APP_ENV=e2e isolates application logic into E2E mock mode.
NODE_ENV=development
APP_ENV=e2e
PORT=3100

# 2. Database Connections (Local PostgreSQL Only)
# Strictly local database: jkishema_e2e on localhost:5432.
# Supabase Development must NEVER be used for E2E tests or cleanup.
DATABASE_URL="postgresql://tiffany@localhost:5432/jkishema_e2e"
DIRECT_URL="postgresql://tiffany@localhost:5432/jkishema_e2e"

# 3. NextAuth Configuration
NEXTAUTH_SECRET="e2e_local_secret_testing_minimum_32_characters_long_jki"
NEXTAUTH_URL="http://localhost:3100"
AUTH_TRUST_HOST=true

# 4. WhatsApp Cloud API Mock Configuration (MANDATORY SAFEGUARD)
# Setting this to true guarantees ZERO outbound HTTP requests to graph.facebook.com
WHATSAPP_MOCK_MODE=true

# 5. Safe Dummy Meta Parameters (No real credentials required in mock mode)
WHATSAPP_CLOUD_API_TOKEN="mock_e2e_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="mock_e2e_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="mock_e2e_waba_account_id"
WHATSAPP_API_VERSION="v22.0"
WHATSAPP_TEMPLATE_NAME="jkishema_registration_qr_3"
WHATSAPP_TEMPLATE_LANG="id"

# 6. Webhook Simulation Secret (Used by E2E test runner to compute HMAC-SHA256 signatures)
WHATSAPP_APP_SECRET="e2e_test_webhook_app_secret_32char"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="e2e_test_webhook_verify_token"
