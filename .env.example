# Database Configuration
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# NextAuth Configuration
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
AUTH_TRUST_HOST="true"

# WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=id
# Mock mode skips Meta entirely (no credentials needed). Default: false.
WHATSAPP_MOCK_MODE=false
# Per-request Meta timeout in ms. Default: 15000.
WHATSAPP_TIMEOUT_MS=15000

# WhatsApp Webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Internal worker endpoint auth. Required - the endpoint fails closed (HTTP 500) without it.
CRON_SECRET=
