{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "node --env-file=.env.e2e.local ./scripts/e2e-env-guard.js ./node_modules/.bin/next dev -p 3100",
    "dev:https": "next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "build": "next build",
    "start": "next start",
    "start:e2e": "node --env-file=.env.e2e.local ./scripts/e2e-env-guard.js ./node_modules/.bin/next start -p 3100",
    "lint": "eslint",
    "test": "jest",
    "create-admin": "ts-node -P tsconfig.scripts.json -r tsconfig-paths/register scripts/create-admin.ts",
    "reset-admin-password": "ts-node -P tsconfig.scripts.json -r tsconfig-paths/register scripts/reset-admin-password.ts",
    "import-csv": "ts-node -P tsconfig.scripts.json -r tsconfig-paths/register scripts/import-csv.ts",
    "test:e2e": "node --env-file=.env.e2e.local ./scripts/e2e-env-guard.js ./node_modules/.bin/playwright test",
    "test:e2e:ui": "node --env-file=.env.e2e.local ./scripts/e2e-env-guard.js ./node_modules/.bin/playwright test --ui",
    "test:e2e:headed": "node --env-file=.env.e2e.local ./scripts/e2e-env-guard.js ./node_modules/.bin/playwright test --headed",
    "db:migrate:e2e": "node --env-file=.env.e2e.local ./scripts/e2e-env-guard.js ./node_modules/.bin/prisma migrate deploy",
    "db:status:e2e": "node --env-file=.env.e2e.local ./scripts/e2e-env-guard.js ./node_modules/.bin/prisma migrate status",
    "postinstall": "prisma generate && (prisma skills sync || exit 0)"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "embla-carousel-react": "^8.6.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.59.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "ts-node -P tsconfig.scripts.json prisma/seed.ts"
  }
}
